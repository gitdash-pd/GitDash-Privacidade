# Copia este ficheiro para .env (o .env não vai para o git) e preenche com a OAuth App do grupo.
# Authorization callback URL: http://localhost:5053/signin-github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Opcional: login GitHub com acesso às listagens gerais de registos (/api/admin/logs).
ADMIN_LOGIN=

# Opcional, só para os testes de cache do 5.3.2 (minutos). Por omissão: 30 e 5.
# CACHE_TTL_MINUTES=1
# CACHE_ACCESS_CHECK_MINUTES=0
